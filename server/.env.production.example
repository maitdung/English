NODE_ENV=production
PORT=3001
API_PREFIX=api

DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?schema=public

REDIS_HOST=HOST
REDIS_PORT=6379
REDIS_PASSWORD=
HEALTH_CHECK_REDIS_ENABLED=false

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900

JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_TTL_SECONDS=604800

PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_EXPOSE_TOKEN=false

# Giữ false để deploy/seed không phụ thuộc API công cộng.
ENABLE_VOCABULARY_ENRICHMENT=false

# Cấu hình secret này trực tiếp trong Render, không commit URL thật.
CLOUDFLARE_PAGES_DEPLOY_HOOK_URL=

FRONTEND_URL=https://english-c0h.pages.dev

# Khóa AI chỉ đặt trong secret manager của nền tảng deploy. Khi không có key,
# Writing vẫn hoạt động bằng bộ chấm cục bộ và lưu lịch sử bình thường.
OPENAI_API_KEY=
XAI_API_KEY=
GROK_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=
OPENAI_WRITING_MODEL=gpt-4o-mini
XAI_WRITING_MODEL=grok-4.3
GEMINI_WRITING_MODEL=gemini-3.5-flash
XAI_SPEAKING_MODEL=grok-4.3
GEMINI_SPEAKING_MODEL=gemini-3.5-flash
AI_REQUEST_TIMEOUT_MS=15000
WRITING_AI_TIMEOUT_MS=20000
# Tự động xóa lịch sử Writing cũ hơn số ngày này (7..3650).
WRITING_RETENTION_DAYS=365
ENABLE_SWAGGER_DOCS=false
