NODE_ENV=development
PORT=3001
API_PREFIX=api

DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
HEALTH_CHECK_REDIS_ENABLED=false

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900

JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_TTL_SECONDS=604800

# Reset token hết hạn sau số phút này.
PASSWORD_RESET_TTL_MINUTES=30

# Chỉ bật ở NODE_ENV=development hoặc test để nhận reset token trực tiếp.
# Ứng dụng sẽ từ chối khởi động nếu cờ này bật trong môi trường khác.
PASSWORD_RESET_EXPOSE_TOKEN=false

# Chỉ bật khi chủ động muốn content import gọi các API từ điển công cộng.
ENABLE_VOCABULARY_ENRICHMENT=false

# Secret deploy hook chỉ dùng ở backend. Không đặt giá trị này trong biến VITE_*.
CLOUDFLARE_PAGES_DEPLOY_HOOK_URL=

FRONTEND_URL=http://localhost:5173
OPENAI_API_KEY=
GROK_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
# Để trống để tự chọn provider đầu tiên có key (OpenAI -> xAI -> Gemini).
AI_PROVIDER=
OPENAI_WRITING_MODEL=gpt-4o-mini
XAI_WRITING_MODEL=grok-4.3
GEMINI_WRITING_MODEL=gemini-3.5-flash
XAI_SPEAKING_MODEL=grok-4.3
GEMINI_SPEAKING_MODEL=gemini-3.5-flash
AI_REQUEST_TIMEOUT_MS=15000
WRITING_AI_TIMEOUT_MS=20000
# Tự động xóa lịch sử Writing cũ hơn số ngày này (7..3650).
WRITING_RETENTION_DAYS=365
ENABLE_SWAGGER_DOCS=true
