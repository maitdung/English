NODE_ENV=development
PORT=3001
API_PREFIX=api

DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900

JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_TTL_SECONDS=604800

# Reset token hết hạn sau số phút này.
PASSWORD_RESET_TTL_MINUTES=30

# Chỉ bật ở NODE_ENV=development hoặc test để nhận reset token trực tiếp.
# Ứng dụng sẽ từ chối khởi động nếu cờ này bật trong môi trường khác.
PASSWORD_RESET_EXPOSE_TOKEN=false

FRONTEND_URL=http://localhost:5173
